WP_ENV=local
WP_HOME=http://127.0.0.1:8000
WP_SITEURL=http://127.0.0.1:8000

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_HOST=127.0.0.1
